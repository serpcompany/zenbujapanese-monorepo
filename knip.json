{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["apps/ios/**"],
  "workspaces": {
    ".": {
      "entry": [".github/actions/*/*.cjs"]
    },
    "apps/web": {
      "entry": ["open-next.config.ts", "e2e/**/*.ts", "scripts/*.ts"]
    },
    "apps/dictionary-api": {
      "entry": ["src/server.ts", "src/worker-dev.mjs", "scripts/*.{ts,mjs}"]
    },
    "apps/account-api": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/dictionary-core": {
      "entry": ["scripts/*.mjs", "src/embedded/javascriptcore.ts"],
      "includeEntryExports": true
    },
    "packages/node-service": {
      "includeEntryExports": true,
      "ignoreDependencies": ["tsx"]
    },
    "tools/checks": {
      "entry": ["pull-request.mjs", "ports.mjs", "review-context.mjs", "review-dry-run.mjs"]
    }
  }
}
