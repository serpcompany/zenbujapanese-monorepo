{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["apps/ios/**"],
  "ignoreBinaries": ["openssl"],
  "workspaces": {
    ".": {
      "entry": [".github/actions/*/*.cjs"],
      "ignoreDependencies": ["lefthook"]
    },
    "apps/web": {
      "entry": ["open-next.config.ts", "e2e/**/*.ts", "scripts/*.ts"]
    },
    "apps/dictionary-api": {
      "entry": ["src/server.ts", "src/worker-dev.mjs", "scripts/*.{ts,mjs,d.mts}"]
    },
    "apps/account-api": {
      "entry": ["scripts/*.mjs"]
    },
    "apps/extension": {
      "entry": [
        "src/pages/*.tsx",
        "src/service-worker/service-worker.ts",
        "src/offscreen/offscreen.ts",
        "src/worker/dictionary-worker.ts",
        "test-pages/test-content-script.tsx",
        "test-pages/*.css",
        "test-pages/vite.config.ts",
        "e2e/*.spec.ts",
        "e2e/serve.ts",
        "playwright.config.ts",
        "agent-chrome/ctl.mjs",
        "agent-chrome/daemon.mjs",
        "agent-chrome/test-daemon.mjs",
        "agent-chrome/selftest-extension/*.js",
        "agent-chrome/site/*.js"
      ]
    },
    "packages/dictionary-core": {
      "entry": ["scripts/*.mjs", "src/embedded/javascriptcore.ts"],
      "includeEntryExports": true
    },
    "packages/account-rules": {
      "entry": ["scripts/*.mjs", "src/embedded/javascriptcore.ts"],
      "includeEntryExports": true
    },
    "packages/ui": {
      "includeEntryExports": true
    },
    "packages/node-service": {
      "includeEntryExports": true,
      "ignoreDependencies": ["tsx"]
    },
    "tools/checks": {
      "entry": [
        "pull-request.mjs",
        "migrations.mjs",
        "ports.mjs",
        "review-context.mjs",
        "review-dry-run.mjs"
      ]
    }
  }
}
