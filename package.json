{
  "name": "zenbujapanese-monorepo",
  "private": true,
  "description": "The Zenbu Japanese product family. The JavaScript apps and packages share this pnpm workspace; each still owns its build, tests, and deploys (ADR 0005).",
  "scripts": {
    "verify": "serp-verify",
    "check": "pnpm verify && pnpm --recursive --workspace-concurrency=1 check",
    "maintenance:report": "pnpm --silent --filter zenbujapanese-checks report",
    "ports": "node tools/checks/ports.mjs"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@serpcompany/verify": "0.1.1",
    "lefthook": "2.0.15"
  }
}
