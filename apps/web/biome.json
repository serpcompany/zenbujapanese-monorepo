{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!.open-next",
      "!.wrangler",
      "!dist",
      "!build",
      "!cloudflare-env.d.ts",
      "!drizzle",
      "!src/lib/dictionary/fixtures/*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off",
            "useFocusableInteractive": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/dictionary/dictionary-breadcrumbs.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/**",
        "src/db/**",
        "!src/lib/dictionary/data.ts",
        "!src/lib/dictionary/retired.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/components",
                      "@/components/**",
                      "@/app",
                      "@/app/**",
                      "@/hooks",
                      "@/hooks/**"
                    ],
                    "message": "src/lib and src/db hold the site's data and logic, which components (src/components), hooks (src/hooks), and routes (src/app) build on, so they never import those (docs/agents/web.md, Code layout). Move what both sides need into src/lib."
                  },
                  {
                    "group": ["@/lib/dictionary/api", "./api"],
                    "message": "Pages read the dictionary service only through src/lib/dictionary/data.ts, which adds the site's URLs and falls back to fixtures in local development; only src/lib/dictionary/retired.ts, which worker.ts runs before Next.js, calls the client too (docs/agents/web.md, Code layout). Add a function to data.ts instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/dictionary/data.ts",
        "src/lib/dictionary/retired.ts",
        "src/lib/moved-pages.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/components",
                      "@/components/**",
                      "@/app",
                      "@/app/**",
                      "@/hooks",
                      "@/hooks/**"
                    ],
                    "message": "src/lib and src/db hold the site's data and logic, which components (src/components), hooks (src/hooks), and routes (src/app) build on, so they never import those (docs/agents/web.md, Code layout). Move what both sides need into src/lib."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/components/**",
        "src/hooks/**",
        "!src/components/dictionary/gate.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**"],
                    "message": "Routes (src/app) import components and hooks, never the reverse (docs/agents/web.md, Code layout). Pass what a component needs from its route as a prop, or move shared code into src/lib."
                  },
                  {
                    "group": ["@/lib/dictionary/api", "./api"],
                    "message": "Pages read the dictionary service only through src/lib/dictionary/data.ts, which adds the site's URLs and falls back to fixtures in local development; only src/lib/dictionary/retired.ts, which worker.ts runs before Next.js, calls the client too (docs/agents/web.md, Code layout). Add a function to data.ts instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/lib/dictionary/api", "./api"],
                    "message": "Pages read the dictionary service only through src/lib/dictionary/data.ts, which adds the site's URLs and falls back to fixtures in local development; only src/lib/dictionary/retired.ts, which worker.ts runs before Next.js, calls the client too (docs/agents/web.md, Code layout). Add a function to data.ts instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "worker.ts", "!src/lib/log.ts", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "console": "The site logs JSON lines through log() in src/lib/log.ts (a level, a message naming the event, and fields), which Workers Logs keep; call it instead of console (docs/agents/web.md, Code layout)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/dictionary/retired.ts",
        "src/lib/dictionary/api.ts",
        "src/lib/dictionary/urls.ts",
        "src/lib/log.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/*", "@/**", "next", "next/**", "react", "react/**", "server-only"],
                    "message": "worker.ts bundles this file outside Next.js, so it imports no Next.js module and no @/ path: use a relative path, and keep Next.js code in the files Next.js builds (docs/agents/web.md, Retired word URLs)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded"
    }
  }
}
