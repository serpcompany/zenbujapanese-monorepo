{
  "name": "zenbujapanese-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "biome format --write",
    "lint": "biome check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:staging": "SITE_ENV=staging opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "deploy:production": "SITE_ENV=production opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types ./cloudflare-env.d.ts --env-interface CloudflareEnv --env-file /dev/null"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@next/third-parties": "^16.3.6",
    "@opennextjs/cloudflare": "^1.20.6",
    "@zenbu/dictionary-core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
