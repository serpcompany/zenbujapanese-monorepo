/**
 * Worker configuration for zenbujapanese.com. The top level is local development; `staging` and
 * `production` are deployed environments. Bindings are not inherited, so each environment repeats
 * them. Every D1 database shares the `DB` binding, schema, and migration ledger (SERP Drizzle + D1
 * standard). See docs/agents/web.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenbujapanese-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zenbujapanese-web-local",
      "database_id": "local-only-do-not-deploy",
      "migrations_dir": "drizzle",
      "migrations_table": "d1_migrations"
    }
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "zenbujapanese-web" }],
  "env": {
    "staging": {
      "vars": { "SITE_ENV": "staging" },
      "workers_dev": true,
      "routes": [{ "pattern": "staging.zenbujapanese.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zenbujapanese-web-staging",
          "database_id": "4af30e21-2703-4060-af22-554bffed3af9",
          "migrations_dir": "drizzle",
          "migrations_table": "d1_migrations"
        }
      ],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "zenbujapanese-web-staging" }]
    },
    "production": {
      "vars": { "SITE_ENV": "production" },
      // Keep workers_dev: CI smoke-tests the workers.dev URL, which skips the zone's bot
      // protection. www redirects to the apex in next.config.ts.
      "workers_dev": true,
      "routes": [
        { "pattern": "zenbujapanese.com", "custom_domain": true },
        { "pattern": "www.zenbujapanese.com", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zenbujapanese-web-production",
          "database_id": "f40fb6bc-c5c0-4215-a78c-39253d64591d",
          "migrations_dir": "drizzle",
          "migrations_table": "d1_migrations"
        }
      ],
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "zenbujapanese-web-production" }
      ]
    }
  }
}
