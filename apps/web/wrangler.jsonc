/**
 * Worker configuration for zenbujapanese.com. The top level is local development; `staging` and
 * `production` are deployed environments. Bindings are not inherited, so each environment repeats
 * them. See docs/agents/web.md.
 *
 * - `DB`, the site's database: every environment shares its schema (src/db/schema.ts),
 *   migrations (drizzle/), and ledger (SERP Drizzle + D1 standard).
 * - `SEARCH_DB`, the dictionary search database: a release database, one D1 per build of the
 *   dictionary, with its own schema (src/db/search-schema.ts) and migrations (drizzle/search/),
 *   imported by `scripts/release-d1/ensure-release.sh search`. Staging names it at deploy time:
 *   `Web deploy` imports and verifies the database, then replaces the SEARCH_DB_* placeholders
 *   with it. Production binds it once its import is gated by a required reviewer (issue 464).
 * - `DICTIONARY_DB`, the dictionary database for word and kanji pages: a release database like
 *   SEARCH_DB, with its own schema (src/db/dictionary-schema.ts) and migrations
 *   (drizzle/dictionary/), imported by `scripts/release-d1/ensure-release.sh dictionary`. Staging
 *   binds it the way it binds SEARCH_DB, through the DICTIONARY_DB_* placeholders. Production has
 *   neither yet, so its dictionary pages return 404.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenbujapanese-web",
  // worker.ts wraps OpenNext's .open-next/worker.js to answer retired word URLs with 410.
  "main": "worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zenbujapanese-web-local",
      "database_id": "local-only-do-not-deploy",
      "migrations_dir": "drizzle",
      "migrations_table": "d1_migrations"
    },
    {
      "binding": "SEARCH_DB",
      "database_name": "zenbujapanese-search-local",
      "database_id": "local-search-only-do-not-deploy",
      "migrations_dir": "drizzle/search",
      "migrations_table": "d1_migrations"
    },
    {
      "binding": "DICTIONARY_DB",
      "database_name": "zenbujapanese-dictionary-local",
      "database_id": "local-dictionary-only-do-not-deploy",
      "migrations_dir": "drizzle/dictionary",
      "migrations_table": "d1_migrations"
    }
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "zenbujapanese-web" }],
  "env": {
    "staging": {
      "vars": { "SITE_ENV": "staging" },
      "workers_dev": true,
      "routes": [{ "pattern": "staging.zenbujapanese.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zenbujapanese-web-staging",
          "database_id": "4af30e21-2703-4060-af22-554bffed3af9",
          "migrations_dir": "drizzle",
          "migrations_table": "d1_migrations"
        },
        {
          "binding": "SEARCH_DB",
          "database_name": "SEARCH_DB_NAME",
          "database_id": "SEARCH_DB_ID",
          "migrations_dir": "drizzle/search",
          "migrations_table": "d1_migrations"
        },
        {
          "binding": "DICTIONARY_DB",
          "database_name": "DICTIONARY_DB_NAME",
          "database_id": "DICTIONARY_DB_ID",
          "migrations_dir": "drizzle/dictionary",
          "migrations_table": "d1_migrations"
        }
      ],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "zenbujapanese-web-staging" }]
    },
    "production": {
      "vars": { "SITE_ENV": "production" },
      // Keep workers_dev: CI smoke-tests the workers.dev URL, which skips the zone's bot
      // protection. www redirects to the apex in next.config.ts.
      "workers_dev": true,
      "routes": [
        { "pattern": "zenbujapanese.com", "custom_domain": true },
        { "pattern": "www.zenbujapanese.com", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zenbujapanese-web-production",
          "database_id": "f40fb6bc-c5c0-4215-a78c-39253d64591d",
          "migrations_dir": "drizzle",
          "migrations_table": "d1_migrations"
        }
      ],
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "zenbujapanese-web-production" }
      ]
    }
  }
}
