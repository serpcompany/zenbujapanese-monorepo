{
  "manifest_version": 3,
  "name": "Agent Chrome self-test",
  "version": "1.0.0",
  "background": { "service_worker": "sw.js" },
  "action": { "default_popup": "popup.html" },
  "permissions": ["offscreen"],
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["content.js"] }]
}
