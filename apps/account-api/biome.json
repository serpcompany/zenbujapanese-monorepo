{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!dist", "!migrations", "!openapi.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["src/http/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../db",
                      "../db/**",
                      "../server",
                      "../wiring",
                      "pg",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "@electric-sql/**",
                      "../auth",
                      "../auth/**",
                      "../email",
                      "../email/**",
                      "better-auth",
                      "better-auth/**",
                      "../billing",
                      "../billing/**",
                      "stripe",
                      "stripe/**",
                      "@apple/**",
                      "../storage",
                      "../storage/**",
                      "aws4fetch"
                    ],
                    "message": "src/http is the HTTP layer: it answers from what src/server.ts and src/wiring.ts hand it (the database's state, the auth handler, the billing rules, the photo files, the dev mailbox), and imports neither the database, sign-in, email, photo storage, nor the payment providers (docs/agents/account-api.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/domain/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../http",
                      "../http/**",
                      "../db",
                      "../db/**",
                      "../server",
                      "../wiring",
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "@zenbu/node-service/http",
                      "pg",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "@electric-sql/**",
                      "../auth",
                      "../auth/**",
                      "../email",
                      "../email/**",
                      "better-auth",
                      "better-auth/**",
                      "../billing",
                      "../billing/**",
                      "stripe",
                      "stripe/**",
                      "@apple/**",
                      "../storage",
                      "../storage/**",
                      "aws4fetch"
                    ],
                    "message": "src/domain holds the account, sync, and billing rules, which the HTTP layer, the database layer, the payment providers' adapters, and photo storage build on, so it imports none of them, nor Hono, nor a database driver, nor a provider's SDK (docs/agents/account-api.md, Code layout). Take what a rule needs as a parameter."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/db/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../http",
                      "../http/**",
                      "../server",
                      "../wiring",
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "@zenbu/node-service/http",
                      "../auth",
                      "../auth/**",
                      "../email",
                      "../email/**",
                      "better-auth",
                      "better-auth/**",
                      "../billing",
                      "../billing/**",
                      "stripe",
                      "stripe/**",
                      "@apple/**",
                      "../storage",
                      "../storage/**",
                      "aws4fetch"
                    ],
                    "message": "src/db is the database layer: sign-in, billing, and the HTTP layer build on it, so it knows nothing of them, nor of a payment provider or photo storage (docs/agents/account-api.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/email/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../http",
                      "../http/**",
                      "../db",
                      "../db/**",
                      "../auth",
                      "../auth/**",
                      "../server",
                      "../wiring",
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "pg",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "better-auth",
                      "better-auth/**",
                      "../billing",
                      "../billing/**",
                      "stripe",
                      "stripe/**",
                      "@apple/**",
                      "../storage",
                      "../storage/**",
                      "aws4fetch"
                    ],
                    "message": "src/email sends a message and nothing more: sign-in uses it, so it imports neither sign-in, the database, nor HTTP (docs/agents/account-api.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/auth/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../http",
                      "../http/**",
                      "../server",
                      "../wiring",
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "../billing",
                      "../billing/**",
                      "stripe",
                      "stripe/**",
                      "@apple/**",
                      "../storage",
                      "../storage/**",
                      "aws4fetch"
                    ],
                    "message": "src/auth sets up sign-in on the database and the mailer; src/server.ts and src/wiring.ts hand its handler to the HTTP layer, so it knows nothing of HTTP (docs/agents/account-api.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/billing/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../http",
                      "../http/**",
                      "../db",
                      "../db/**",
                      "../auth",
                      "../auth/**",
                      "../email",
                      "../email/**",
                      "../server",
                      "../wiring",
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "pg",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "better-auth",
                      "better-auth/**",
                      "../storage",
                      "../storage/**",
                      "aws4fetch"
                    ],
                    "message": "src/billing holds the payment providers' adapters, Stripe's and the App Store's, behind the domain's billing interfaces; src/server.ts and src/wiring.ts hand them to the domain, so they know nothing of HTTP, the database, sign-in, email, or photo storage (docs/agents/account-billing.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/storage/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../http",
                      "../http/**",
                      "../db",
                      "../db/**",
                      "../auth",
                      "../auth/**",
                      "../email",
                      "../email/**",
                      "../server",
                      "../wiring",
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "pg",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "better-auth",
                      "better-auth/**",
                      "../billing",
                      "../billing/**",
                      "stripe",
                      "stripe/**",
                      "@apple/**"
                    ],
                    "message": "src/storage keeps photo files in R2 behind the domain's PhotoStorage, and nothing more: src/server.ts and src/wiring.ts hand it to the domain, so it imports neither HTTP, the database, sign-in, email, nor the payment providers (docs/agents/account-api.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/config.ts", "src/billing-config.ts", "src/failure.ts", "src/language.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "./http",
                      "./http/**",
                      "./db",
                      "./db/**",
                      "./domain",
                      "./domain/**",
                      "./server",
                      "./wiring",
                      "hono",
                      "hono/**",
                      "pg",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "./auth",
                      "./auth/**",
                      "./billing",
                      "./billing/**",
                      "./email",
                      "./email/**",
                      "./storage",
                      "./storage/**",
                      "stripe",
                      "@apple/**"
                    ],
                    "message": "src/config.ts and src/billing-config.ts read the environment, src/failure.ts describes an error for the log, and src/language.ts names the language an email is in; they sit below every layer, so they import none (docs/agents/account-api.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "console": "The service logs JSON lines through log() from @zenbu/node-service/log (a level, a message naming the event, and fields), and never a learner's email, a code, a token, or a link; call it instead of console (docs/agents/account-api.md, Code layout)."
                }
              }
            }
          }
        }
      }
    }
  ]
}
