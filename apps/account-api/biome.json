{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!dist", "!migrations"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["src/http/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../db",
                      "../db/**",
                      "../server",
                      "pg",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "@electric-sql/**",
                      "../auth",
                      "../auth/**",
                      "../email",
                      "../email/**",
                      "better-auth",
                      "better-auth/**"
                    ],
                    "message": "src/http is the HTTP layer: it answers from what src/server.ts hands it (the database's state, the auth handler, the dev mailbox), and imports neither the database, sign-in, nor email (docs/agents/account-api.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/domain/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../http",
                      "../http/**",
                      "../db",
                      "../db/**",
                      "../server",
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "@zenbu/node-service/http",
                      "pg",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "@electric-sql/**",
                      "../auth",
                      "../auth/**",
                      "../email",
                      "../email/**",
                      "better-auth",
                      "better-auth/**"
                    ],
                    "message": "src/domain holds the account and sync rules, which the HTTP layer and the database layer both build on, so it imports neither, nor Hono, nor a database driver (docs/agents/account-api.md, Code layout). Take what a rule needs as a parameter."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/db/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../http",
                      "../http/**",
                      "../server",
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "@zenbu/node-service/http",
                      "../auth",
                      "../auth/**",
                      "../email",
                      "../email/**",
                      "better-auth",
                      "better-auth/**"
                    ],
                    "message": "src/db is the database layer: sign-in and the HTTP layer build on it, so it knows nothing of them (docs/agents/account-api.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/email/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../http",
                      "../http/**",
                      "../db",
                      "../db/**",
                      "../auth",
                      "../auth/**",
                      "../server",
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "pg",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "better-auth",
                      "better-auth/**"
                    ],
                    "message": "src/email sends a message and nothing more: sign-in uses it, so it imports neither sign-in, the database, nor HTTP (docs/agents/account-api.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/auth/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../http", "../http/**", "../server", "hono", "hono/**", "@hono/**"],
                    "message": "src/auth sets up sign-in on the database and the mailer; src/server.ts hands its handler to the HTTP layer, so it knows nothing of HTTP (docs/agents/account-api.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/config.ts", "src/failure.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "./http",
                      "./http/**",
                      "./db",
                      "./db/**",
                      "./domain",
                      "./domain/**",
                      "./server",
                      "hono",
                      "hono/**",
                      "pg",
                      "drizzle-orm",
                      "drizzle-orm/**"
                    ],
                    "message": "src/config.ts reads the environment and src/failure.ts describes an error for the log; both sit below every layer, so they import none (docs/agents/account-api.md, Code layout)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "console": "The service logs JSON lines through log() from @zenbu/node-service/log (a level, a message naming the event, and fields), and never a learner's email, a code, a token, or a link; call it instead of console (docs/agents/account-api.md, Code layout)."
                }
              }
            }
          }
        }
      }
    }
  ]
}
