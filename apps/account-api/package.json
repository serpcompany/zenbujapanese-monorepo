{
  "name": "zenbujapanese-account-api",
  "version": "0.1.0",
  "private": true,
  "description": "Zenbu accounts, sign-in, and sync: a Node service with Postgres on the API servers (ADR 0011).",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "start": "node dist/server.mjs",
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "format": "biome format --write",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@zenbu/node-service": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.11",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
