                "description": "The service's build, quoted. Send it back as `If-None-Match` to revalidate.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "`private, max-age=86400`: keep the answer a day, then revalidate.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "`bad_request`: `text` is blank, or over 200 characters.",
            "content": {
              "application/json": {
