{
  "name": "zenbujapanese-dictionary-api",
  "version": "0.1.0",
  "private": true,
  "description": "The website's dictionary service: the shared core (packages/dictionary-core) on the artifact, with Kuromoji and Sudachi (ADR 0009).",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "start": "node dist/server.mjs",
    "build": "node scripts/build.mjs",
    "sudachi": "node scripts/fetch-sudachi.mjs",
    "fixtures": "node --import tsx scripts/export-fixtures.ts",
    "format": "biome format --write",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@nikkei/napi-sudachi": "0.12.0",
    "@zenbu/dictionary-core": "workspace:*",
    "hono": "^4.13.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
