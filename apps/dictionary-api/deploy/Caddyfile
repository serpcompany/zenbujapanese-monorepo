# The dictionary service's HTTPS front on its server, for Caddy (https://caddyserver.com). Caddy gets
# the certificate for the host name itself, and sends each request to whichever of the service's
# two slots answers /healthz, so host-deploy.sh can start a new image beside the old one and stop
# the old one without dropping a request. Replace the host name with this server's, and install it
# as /etc/caddy/Caddyfile (docs/agents/dictionary-api.md, Ship it).

dictionary-staging.zenbujapanese.com {
	reverse_proxy 127.0.0.1:8788 127.0.0.1:8789 {
		lb_policy first
		# A request to a slot that just stopped tries the other one.
		lb_try_duration 10s
		health_uri /healthz
		health_interval 2s
	}
}
