{
  "name": "@zenbu/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The website's look, shared with the browser extension: the shadcn primitives, the theme, and the word components, which take their text, links, and actions from each client.",
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./dictionary/voice": "./src/dictionary/voice.ts",
    "./dictionary/*": "./src/dictionary/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.tsx",
    "./styles/*": "./src/styles/*",
    "./vitest-projects": "./vitest.projects.ts"
  },
  "scripts": {
    "format": "biome format --write",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@zenbu/dictionary-core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.48.0",
    "react": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^20.14.5",
    "react-dom": "19.2.8",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
