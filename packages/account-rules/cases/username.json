{
  "rule": "A username is 3 to 30 letters a to z, digits, or underscores.",
  "accepted": [
    { "covers": "three characters, the fewest", "typed": "abc", "username": "abc" },
    {
      "covers": "thirty characters, the most",
      "typed": "abcdefghijklmnopqrstuvwxyz0123",
      "username": "abcdefghijklmnopqrstuvwxyz0123"
    },
    {
      "covers": "an uppercase letter, which is lowercased",
      "typed": "Kana_Fan",
      "username": "kana_fan"
    },
    { "covers": "underscores only", "typed": "___", "username": "___" },
    { "covers": "digits only", "typed": "12345", "username": "12345" },
    {
      "covers": "spaces around it, which are trimmed",
      "typed": "  kana_fan ",
      "username": "kana_fan"
    },
    {
      "covers": "full-width letters, digits, and underscore, which NFKC folds",
      "typed": "ＫＡＮＡ＿１",
      "username": "kana_1"
    },
    {
      "covers": "a byte order mark before it, which is trimmed as JavaScript trims",
      "typed": "\ufeffkana",
      "username": "kana"
    },
    {
      "covers": "thirty characters with spaces around them, counted once trimmed",
      "typed": " abcdefghijklmnopqrstuvwxyz0123 ",
      "username": "abcdefghijklmnopqrstuvwxyz0123"
    },
    {
      "covers": "ideographic spaces around it, which NFKC folds to spaces",
      "typed": "\u3000kana_fan\u3000",
      "username": "kana_fan"
    },
    {
      "covers": "a two-character ligature and a letter, counted once NFKC unfolds the ligature",
      "typed": "ﬁx",
      "username": "fix"
    },
    {
      "covers": "mathematical bold letters, outside the basic plane, which NFKC folds",
      "typed": "𝐚𝐛𝐜",
      "username": "abc"
    },
    {
      "covers": "thirty mathematical bold letters, sixty UTF-16 units, counted as thirty",
      "typed": { "text": "𝐚", "times": 30 },
      "username": { "text": "a", "times": 30 }
    }
  ],
  "refused": [
    { "covers": "two characters, one too few", "typed": "ab" },
    { "covers": "two characters once trimmed", "typed": " ab " },
    { "covers": "thirty-one characters, one too many", "typed": "abcdefghijklmnopqrstuvwxyz01234" },
    { "covers": "a period", "typed": "kana.fan" },
    { "covers": "a hyphen", "typed": "kana-fan" },
    { "covers": "a space inside it", "typed": "kana fan" },
    { "covers": "a leading at sign", "typed": "@kana_fan" },
    { "covers": "Japanese letters", "typed": "かなふぁん" },
    { "covers": "a kanji outside the basic plane", "typed": "kana𠀋" },
    { "covers": "an accented Latin letter", "typed": "é_fan" },
    { "covers": "a capital dotted I, which lowercases to i and a combining dot", "typed": "İkana" },
    {
      "covers": "a next-line control after it, which JavaScript does not trim",
      "typed": "kana\u0085"
    },
    { "covers": "nothing", "typed": "" },
    { "covers": "only spaces", "typed": "   " },
    { "covers": "a byte order mark inside it", "typed": "ka\ufeffna" },
    { "covers": "a zero-width space inside it", "typed": "ka\u200bna" },
    { "covers": "an emoji", "typed": "kana😀" },
    {
      "covers": "only a next-line control, which JavaScript does not trim, so it is not blank",
      "typed": "\u0085"
    }
  ],
  "removes": [
    { "covers": "nothing", "typed": "" },
    { "covers": "only spaces", "typed": "   " },
    { "covers": "only a byte order mark, which JavaScript trims", "typed": "\ufeff" },
    { "covers": "only an ideographic space", "typed": "\u3000" }
  ]
}
