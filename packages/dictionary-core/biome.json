{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!src/fixtures/*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "next",
                      "next/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "@opennextjs/**",
                      "server-only",
                      "wrangler",
                      "hono",
                      "hono/**"
                    ],
                    "message": "The dictionary core runs on every client, from a Node service to a browser extension and the app (ADR 0009), so it imports no runtime or framework. Take what a client provides (a database, a file, a capability) as a parameter, and put Node-only code in apps/dictionary-api."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "console": "The dictionary core runs on every client and logs nothing: return what happened, as a result or an error, and let the client log it (docs/agents/dictionary-core.md)."
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded"
    }
  }
}
