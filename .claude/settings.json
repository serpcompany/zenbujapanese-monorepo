      "PowerShell(npx wrangler versions upload*)",
      "PowerShell(npx wrangler rollback*)",
      "PowerShell(npx wrangler delete*)",
      "PowerShell(npx wrangler secret *)",
      "PowerShell(npx wrangler@* * --remote*)",
      "PowerShell(npx wrangler@* deploy*)",
      "PowerShell(npx wrangler@* versions deploy*)",
      "PowerShell(npx wrangler@* versions upload*)",
      "PowerShell(npx wrangler@* rollback*)",
      "PowerShell(npx wrangler@* delete*)",
      "PowerShell(npx wrangler@* secret *)",
      "PowerShell(pnpm wrangler * --remote*)",
      "PowerShell(pnpm wrangler deploy*)",
      "PowerShell(pnpm wrangler versions deploy*)",
      "PowerShell(pnpm wrangler versions upload*)",
      "PowerShell(pnpm wrangler rollback*)",
