{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "chrome-devtools"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/checks/hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(sftp *)",
      "PowerShell(rsync *)"
    ],
    "ask": [
      "Bash(wrangler * --remote*)",
      "Bash(wrangler deploy*)",
      "Bash(wrangler versions deploy*)",
      "Bash(wrangler versions upload*)",
      "Bash(wrangler rollback*)",
      "Bash(wrangler delete*)",
      "Bash(wrangler secret *)",
      "Bash(npx wrangler * --remote*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler versions deploy*)",
      "Bash(npx wrangler versions upload*)",
      "Bash(npx wrangler rollback*)",
      "Bash(npx wrangler delete*)",
      "Bash(npx wrangler secret *)",
      "Bash(npx wrangler@* * --remote*)",
      "Bash(npx wrangler@* deploy*)",
      "Bash(npx wrangler@* versions deploy*)",
      "Bash(npx wrangler@* versions upload*)",
      "Bash(npx wrangler@* rollback*)",
      "Bash(npx wrangler@* delete*)",
      "Bash(npx wrangler@* secret *)",
      "Bash(pnpm wrangler * --remote*)",
      "Bash(pnpm wrangler deploy*)",
      "Bash(pnpm wrangler versions deploy*)",
      "Bash(pnpm wrangler versions upload*)",
      "Bash(pnpm wrangler rollback*)",
      "Bash(pnpm wrangler delete*)",
      "Bash(pnpm wrangler secret *)",
      "Bash(pnpm exec wrangler * --remote*)",
      "Bash(pnpm exec wrangler deploy*)",
      "Bash(pnpm exec wrangler versions deploy*)",
      "Bash(pnpm exec wrangler versions upload*)",
      "Bash(pnpm exec wrangler rollback*)",
      "Bash(pnpm exec wrangler delete*)",
      "Bash(pnpm exec wrangler secret *)",
      "Bash(opennextjs-cloudflare deploy*)",
      "Bash(opennextjs-cloudflare upload*)",
      "Bash(npx opennextjs-cloudflare deploy*)",
      "Bash(npx opennextjs-cloudflare upload*)",
      "Bash(npx @opennextjs/cloudflare* deploy*)",
      "Bash(npx @opennextjs/cloudflare* upload*)",
      "Bash(pnpm opennextjs-cloudflare deploy*)",
      "Bash(pnpm opennextjs-cloudflare upload*)",
      "Bash(pnpm exec opennextjs-cloudflare deploy*)",
      "Bash(pnpm exec opennextjs-cloudflare upload*)",
      "Bash(pnpm *deploy:*)",
      "Bash(pnpm *:staging*)",
      "Bash(pnpm *:production*)",
      "Bash(docker push*)",
      "Bash(docker buildx imagetools create*)",
      "Bash(gh workflow run*)",
      "Bash(gh run rerun*)",
      "Bash(gh pr merge*)",
      "Bash(gh secret *)",
      "Bash(gh variable set*)",
      "Bash(gh variable delete*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api graphql*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(python *publish.py*)",
      "Bash(python3 *publish.py*)",
      "Bash(py *publish.py*)",
