{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["chrome-devtools"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/checks/hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(sftp *)"
    ],
    "ask": [
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions *)",
      "Bash(*wrangler rollback*)",
      "Bash(*wrangler delete*)",
      "Bash(*wrangler secret *)",
      "Bash(*wrangler * --remote*)",
      "Bash(*opennextjs-cloudflare deploy*)",
      "Bash(*opennextjs-cloudflare upload*)",
      "Bash(pnpm *deploy:*)",
      "Bash(pnpm *:staging*)",
      "Bash(pnpm *:production*)",
      "Bash(*docker push*)",
      "Bash(*docker buildx imagetools create*)",
      "Bash(gh workflow run*)",
      "Bash(gh run rerun*)",
      "Bash(gh pr merge*)",
      "Bash(gh secret *)",
      "Bash(gh variable set*)",
      "Bash(gh variable delete*)",
      "Bash(gh api *-X *)",
      "Bash(gh api *--method *)",
      "Bash(*publish.py*)",
      "PowerShell(*wrangler deploy*)",
      "PowerShell(*wrangler versions *)",
      "PowerShell(*wrangler rollback*)",
      "PowerShell(*wrangler delete*)",
      "PowerShell(*wrangler secret *)",
      "PowerShell(*wrangler * --remote*)",
      "PowerShell(*opennextjs-cloudflare deploy*)",
      "PowerShell(*opennextjs-cloudflare upload*)",
      "PowerShell(pnpm *deploy:*)",
      "PowerShell(pnpm *:staging*)",
      "PowerShell(pnpm *:production*)",
      "PowerShell(*docker push*)",
      "PowerShell(*docker buildx imagetools create*)",
      "PowerShell(gh workflow run*)",
      "PowerShell(gh run rerun*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh secret *)",
      "PowerShell(gh variable set*)",
      "PowerShell(gh variable delete*)",
      "PowerShell(gh api *-X *)",
      "PowerShell(gh api *--method *)",
      "PowerShell(*publish.py*)"
    ]
  }
}
