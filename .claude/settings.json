      "PowerShell(opennextjs-cloudflare deploy*)",
      "PowerShell(opennextjs-cloudflare upload*)",
      "PowerShell(npx opennextjs-cloudflare deploy*)",
      "PowerShell(npx opennextjs-cloudflare upload*)",
      "PowerShell(npx @opennextjs/cloudflare* deploy*)",
      "PowerShell(npx @opennextjs/cloudflare* upload*)",
      "PowerShell(pnpm opennextjs-cloudflare deploy*)",
      "PowerShell(pnpm opennextjs-cloudflare upload*)",
      "PowerShell(pnpm exec opennextjs-cloudflare deploy*)",
      "PowerShell(pnpm exec opennextjs-cloudflare upload*)",
      "PowerShell(pnpm *deploy:*)",
      "PowerShell(pnpm *:staging*)",
      "PowerShell(pnpm *:production*)",
      "PowerShell(docker push*)",
      "PowerShell(docker buildx imagetools create*)",
      "PowerShell(gh workflow run*)",
      "PowerShell(gh run rerun*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh secret *)",
      "PowerShell(gh variable set*)",
      "PowerShell(gh variable delete*)",
      "PowerShell(gh api *-X*)",
      "PowerShell(gh api *--method*)",
      "PowerShell(gh api graphql*)",
      "PowerShell(gh api *-f *)",
      "PowerShell(gh api *-F *)",
      "PowerShell(gh api *--field*)",
      "PowerShell(gh api *--raw-field*)",
      "PowerShell(gh api *--input*)",
      "PowerShell(python *publish.py*)",
